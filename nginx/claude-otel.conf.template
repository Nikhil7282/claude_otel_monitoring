# The monitoring stack behind the server's existing nginx. Render with nginx/render.sh;
# see docs/deploy-hostinger.md. IPv4 only: the hostnames have no IPv6 (AAAA) record.

# Devices send OTLP over gRPC, which needs HTTP/2.
server {
    listen 443 ssl http2;
    server_name otel.{{DOMAIN}};

    ssl_certificate {{CERT_DIR}}/fullchain.pem;
    ssl_certificate_key {{CERT_DIR}}/privkey.pem;

    location / {
        grpc_pass grpc://{{COLLECTOR_UPSTREAM}};
    }
}

server {
    listen 443 ssl http2;
    server_name grafana.{{DOMAIN}};

    ssl_certificate {{CERT_DIR}}/fullchain.pem;
    ssl_certificate_key {{CERT_DIR}}/privkey.pem;

    location / {
        proxy_pass http://{{GRAFANA_UPSTREAM}};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Grafana Live (dashboard auto-refresh) uses WebSockets.
    location /api/live/ {
        proxy_pass http://{{GRAFANA_UPSTREAM}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# Plain HTTP only redirects; certbot also answers its renewal checks here.
server {
    listen 80;
    server_name otel.{{DOMAIN}} grafana.{{DOMAIN}};
    return 301 https://$host$request_uri;
}
