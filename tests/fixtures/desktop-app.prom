# Mirrors the Claude Desktop app's Code tab on 2026-10-31: the app sets its own resource
# attributes, so there is no device_id or host_name, only the Mac's user name.
claude_code_cost_usage_USD_total{service_name="claude-code-desktop",process_owner="cyberminds",user_email="company-one@example.com",session_id="s-desktop",model="claude-opus-5-5"} 2.5
claude_code_active_time_seconds_total{service_name="claude-code-desktop",process_owner="cyberminds",user_email="company-one@example.com",session_id="s-desktop",type="user"} 600
claude_code_lines_of_code_count_total{service_name="claude-code-desktop",process_owner="cyberminds",user_email="company-one@example.com",session_id="s-desktop",type="added"} 40
# Terminal Claude Code on a Device, which keeps the Device labels.
claude_code_active_time_seconds_total{service_name="claude-code",device_id="FIXTURE-DEVICE",host_name="fixture-host",user_email="company-one@example.com",session_id="s-one-a",type="user"} 300
