# Copy to k8s/settings.env and fill in. k8s/settings.env is git-ignored.
# No spaces around "=" and no comments after a value: Kustomize reads values literally.

# The company subdomain. Devices send to otel.<DOMAIN>, the dashboard is grafana.<DOMAIN>.
DOMAIN=claude.example.com

# The cert-manager ClusterIssuer that issues the two certificates (kubectl get clusterissuer).
CLUSTER_ISSUER=letsencrypt-prod
