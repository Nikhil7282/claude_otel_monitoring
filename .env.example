# Copy to .env on the server and fill in real values. .env is git-ignored.

# Shared bearer token every Device sends. Generate with: openssl rand -hex 32
OTEL_AUTH_TOKEN=change-me

# Company Account allowlist: comma-separated emails, no spaces. Telemetry from any other
# account is dropped. Kept here, not in git, so the addresses stay private.
COMPANY_ACCOUNTS=first@example.com,second@example.com
