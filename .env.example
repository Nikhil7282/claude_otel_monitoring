# Copy to .env on the server and fill in real values. .env is git-ignored.
# One KEY=value per line: no quotes, no spaces around "=", no comments after a value.
# Kubernetes reads this file literally, so a quoted token would keep its quotes.

# Makes a plain `docker compose ...` use the production setup: the stack on localhost-only
# ports, behind the server's nginx.
COMPOSE_FILE=compose.yaml:compose.nginx.yaml

# The company subdomain the server answers on. Devices send to otel.<DOMAIN> and the
# dashboard is at grafana.<DOMAIN>; both need an A record pointing at the server.
DOMAIN=claude.example.com

# Shared bearer token every Device sends. Generate with: openssl rand -hex 32
OTEL_AUTH_TOKEN=change-me

# Company Account allowlist: comma-separated emails, no spaces. Telemetry from any other
# account is dropped. Kept here, not in git, so the addresses stay private.
COMPANY_ACCOUNTS=first@example.com,second@example.com

# Password for Grafana's "admin" user. Generate with: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=change-me
